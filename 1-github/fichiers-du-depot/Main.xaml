<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sablier" Width="420" Height="760" MinWidth="420" MaxWidth="420" MinHeight="760" MaxHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF0A0C12" Foreground="#FFF3F5F9" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Ambiance : halos qui dérivent + anneau qui respire. Lancée par le code, en pause quand la fenêtre n'est pas au premier plan. -->
    <Storyboard x:Key="Ambiance" Timeline.DesiredFrameRate="20">
      <DoubleAnimation Storyboard.TargetName="Halo1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="160" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Halo1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="120" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Halo2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-170" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Halo2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="140" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Halo3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="220" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Arc" Storyboard.TargetProperty="Opacity" From="0.75" To="1" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>

  <Grid ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Aurore : halos d'accent qui dérivent lentement -->
    <Canvas Grid.RowSpan="4" IsHitTestVisible="False">
      <Ellipse x:Name="Halo1" CacheMode="BitmapCache" Width="480" Height="480" Canvas.Left="-220" Canvas.Top="-200">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#45%A1%" Offset="0"/>
            <GradientStop Color="#00%A1%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="Halo2" CacheMode="BitmapCache" Width="440" Height="440" Canvas.Left="200" Canvas.Top="180">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#38%A2%" Offset="0"/>
            <GradientStop Color="#00%A2%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="Halo3" CacheMode="BitmapCache" Width="360" Height="360" Canvas.Left="-120" Canvas.Top="520">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#26%A1%" Offset="0"/>
            <GradientStop Color="#00%A1%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>

    <!-- Barre de titre -->
    <Grid Margin="20,0,10,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource Grad}">
          <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#FF0A0E17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Sablier" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <Border Margin="10,1,0,0" Padding="8,3" CornerRadius="7" Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" VerticalAlignment="Center">
          <TextBlock x:Name="Machine" FontSize="10.5" FontWeight="Bold" Foreground="#FF%A1%"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="BtnMin" Style="{StaticResource Chrome}" Content="&#xE921;" ToolTip="Réduire" AutomationProperties.Name="Réduire"/>
        <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#xE8BB;" ToolTip="Fermer" AutomationProperties.Name="Fermer"/>
      </StackPanel>
    </Grid>

    <!-- Anneau : prochain évènement -->
    <StackPanel Grid.Row="1">
      <Grid Width="232" Height="232">
        <Ellipse Margin="16" Stroke="#12FFFFFF" StrokeThickness="10"/>
        <Ellipse Margin="34" Fill="#07FFFFFF"/>
        <Path CacheMode="BitmapCache" x:Name="Arc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
          <Path.Stroke>
            <LinearGradientBrush MappingMode="Absolute" StartPoint="20,20" EndPoint="212,212">
              <GradientStop Color="#FF%A1%" Offset="0"/>
              <GradientStop Color="#FF%A2%" Offset="1"/>
            </LinearGradientBrush>
          </Path.Stroke>
          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
          <Path.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="24" Color="#FF%A1%" Opacity="0.7"/></Path.Effect>
        </Path>
        <Canvas>
          <Ellipse CacheMode="BitmapCache" x:Name="Head" Width="14" Height="14" Fill="White">
            <Ellipse.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="16" Color="#FF%A2%" Opacity="1"/></Ellipse.Effect>
          </Ellipse>
        </Canvas>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="HeroBig" Text="--:--" FontSize="42" FontWeight="Light" HorizontalAlignment="Center"/>
          <TextBlock x:Name="HeroSub" FontSize="13" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="HeroInfo" HorizontalAlignment="Center" FontSize="13" Foreground="#FFC9D1E0"/>
      <StackPanel x:Name="HeroActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Hidden">
        <Button x:Name="BtnCancelTimer" Style="{StaticResource Btn}" Height="34" Padding="16,0" Margin="4,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="Annuler"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnPlus15" Style="{StaticResource Btn}" Height="34" Padding="16,0" Margin="4,0" Content="+15 min"/>
      </StackPanel>
    </StackPanel>

    <!-- Onglets -->
    <Grid Grid.Row="2" Margin="24,12,24,0" Height="44">
      <Border CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"/>
      <Border x:Name="TabPill" Width="182" HorizontalAlignment="Left" Margin="4" CornerRadius="10" Background="#1CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      </Border>
      <UniformGrid Columns="2" Margin="4">
        <RadioButton x:Name="TabTimer" Style="{StaticResource Tab}" IsChecked="True">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="Minuterie"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabProg" Style="{StaticResource Tab}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE787;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="Programmes"/>
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </Grid>

    <Grid Grid.Row="3" Margin="24,16,24,22">
      <!-- Minuterie -->
      <StackPanel x:Name="PanelTimer">
        <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        <Border x:Name="DureeCard" Style="{StaticResource Card}" Padding="14,12,14,10">
          <StackPanel>
            <TextBlock Text="DANS" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
            <Grid Margin="0,2,0,0">
              <Button x:Name="BtnMoins" Style="{StaticResource Btn}" Width="44" Height="44" HorizontalAlignment="Left" FontFamily="{StaticResource Icons}" FontSize="14" Content="&#xE738;" AutomationProperties.Name="Diminuer la durée"/>
              <TextBlock x:Name="Duree" Text="1 h" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
              </TextBlock>
              <Button x:Name="BtnPlus" Style="{StaticResource Btn}" Width="44" Height="44" HorizontalAlignment="Right" FontFamily="{StaticResource Icons}" FontSize="14" Content="&#xE710;" AutomationProperties.Name="Augmenter la durée"/>
            </Grid>
            <UniformGrid x:Name="Presets" Columns="5" Margin="-3,10,-3,0">
              <Button Style="{StaticResource Mini}" Tag="15" Content="15 min"/>
              <Button Style="{StaticResource Mini}" Tag="30" Content="30 min"/>
              <Button Style="{StaticResource Mini}" Tag="60" Content="1 h"/>
              <Button Style="{StaticResource Mini}" Tag="120" Content="2 h"/>
              <Button Style="{StaticResource Mini}" Tag="180" Content="3 h"/>
            </UniformGrid>
          </StackPanel>
        </Border>
        <TextBlock Text="ACTION" Style="{StaticResource Label}" Margin="4,16,0,6"/>
        <UniformGrid x:Name="ActionsTimer" Columns="4" Margin="-3,0">
          <RadioButton Style="{StaticResource Seg}" Tag="shutdown" IsChecked="True">
            <StackPanel><TextBlock Text="&#xE7E8;" Style="{StaticResource SegIcon}"/><TextBlock Text="Arrêt" Style="{StaticResource SegText}"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" Tag="restart">
            <StackPanel><TextBlock Text="&#xE72C;" Style="{StaticResource SegIcon}"/><TextBlock Text="Redémarrer" Style="{StaticResource SegText}"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" Tag="sleep">
            <StackPanel><TextBlock Text="&#xE708;" Style="{StaticResource SegIcon}"/><TextBlock Text="Veille" Style="{StaticResource SegText}"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" Tag="hibernate">
            <StackPanel><TextBlock Text="&#xE823;" Style="{StaticResource SegIcon}"/><TextBlock Text="Hibernation" Style="{StaticResource SegText}"/></StackPanel>
          </RadioButton>
        </UniformGrid>
        <Button x:Name="BtnGo" Style="{StaticResource Cta}" Height="56" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock Text="Lancer la minuterie" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="GoSub" FontSize="11.5" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Programmes -->
      <Grid x:Name="PanelProg" Visibility="Collapsed">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
          <ItemsControl x:Name="Liste">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
                  <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                  <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.4">
                          <DoubleAnimation.EasingFunction><CubicEase/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard></BeginStoryboard>
                    </EventTrigger>
                  </Border.Triggers>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="13" Background="{Binding Fond}">
                      <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="#FF0A0E17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Heure}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Titre}" FontSize="12.5" Foreground="#FFC9D1E0" Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Sous}" FontSize="12" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="Empêche l'allumage prévu" FontSize="11.5" Foreground="#FFFBBF24" Margin="0,2,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Bloque}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Actif, Mode=OneWay}" Tag="{Binding}" VerticalAlignment="Center"
                                  ToolTip="Activer / mettre en pause" AutomationProperties.Name="Activer le programme"/>
                    <Button Grid.Column="3" Style="{StaticResource Btn}" Width="34" Height="34" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                            FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" Content="&#xE74D;" Tag="{Binding}"
                            ToolTip="Supprimer" AutomationProperties.Name="Supprimer le programme"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="Vide" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="&#xE787;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
          <TextBlock Text="Aucun programme" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
          <TextBlock Text="Éteignez ou allumez ce PC automatiquement, une fois ou chaque semaine." TextWrapping="Wrap" TextAlignment="Center" Width="260" Foreground="{StaticResource Sub}"/>
        </StackPanel>
        <Button x:Name="BtnNouveau" Grid.Row="1" Style="{StaticResource Cta}" Height="52" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,1,10,0"/>
            <TextBlock Text="Nouveau programme"/>
          </StackPanel>
        </Button>
      </Grid>
    </Grid>

    <!-- Fiche « Nouveau programme » qui monte du bas -->
    <Grid x:Name="Sheet" Grid.RowSpan="4" Visibility="Collapsed">
      <Border x:Name="SheetDim" Background="#B305070C" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Border x:Name="SheetCard" VerticalAlignment="Bottom" CornerRadius="26,26,0,0" Background="#FF121621" BorderBrush="#1FFFFFFF" BorderThickness="1,1,1,0" Padding="24,12,24,22">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        <StackPanel>
          <Border Width="42" Height="4" CornerRadius="2" Background="#33FFFFFF" HorizontalAlignment="Center"/>
          <TextBlock Text="Nouveau programme" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,12"/>
          <UniformGrid Columns="2" Margin="-3,0">
            <RadioButton x:Name="KindOff" Style="{StaticResource Seg}" IsChecked="True">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0"/>
                <TextBlock Text="Éteindre" FontSize="13.5" FontWeight="SemiBold"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="KindOn" Style="{StaticResource Seg}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0"/>
                <TextBlock Text="Allumer" FontSize="13.5" FontWeight="SemiBold"/>
              </StackPanel>
            </RadioButton>
          </UniformGrid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <StackPanel>
              <RepeatButton x:Name="HUp" Style="{StaticResource Spin}" Content="&#xE70E;" AutomationProperties.Name="Heure suivante"/>
              <TextBox x:Name="HH" Style="{StaticResource TimeBox}" AutomationProperties.Name="Heures"/>
              <RepeatButton x:Name="HDown" Style="{StaticResource Spin}" Content="&#xE70D;" AutomationProperties.Name="Heure précédente"/>
            </StackPanel>
            <TextBlock Text=":" FontSize="44" FontWeight="Light" VerticalAlignment="Center" Margin="10,0,10,8" Foreground="{StaticResource Sub}"/>
            <StackPanel>
              <RepeatButton x:Name="MUp" Style="{StaticResource Spin}" Content="&#xE70E;" AutomationProperties.Name="Minutes suivantes"/>
              <TextBox x:Name="MM" Style="{StaticResource TimeBox}" AutomationProperties.Name="Minutes"/>
              <RepeatButton x:Name="MDown" Style="{StaticResource Spin}" Content="&#xE70D;" AutomationProperties.Name="Minutes précédentes"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="JOURS" Style="{StaticResource Label}" Margin="4,10,0,8"/>
          <UniformGrid x:Name="Jours" Columns="7">
            <ToggleButton Style="{StaticResource Day}" Content="L"/>
            <ToggleButton Style="{StaticResource Day}" Content="M"/>
            <ToggleButton Style="{StaticResource Day}" Content="M"/>
            <ToggleButton Style="{StaticResource Day}" Content="J"/>
            <ToggleButton Style="{StaticResource Day}" Content="V"/>
            <ToggleButton Style="{StaticResource Day}" Content="S"/>
            <ToggleButton Style="{StaticResource Day}" Content="D"/>
          </UniformGrid>
          <Grid Margin="4,14,0,0">
            <TextBlock Text="Répéter chaque semaine" FontSize="13.5" VerticalAlignment="Center"/>
            <ToggleButton x:Name="Repeat" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/>
          </Grid>
          <Grid Margin="0,14,0,0">
            <StackPanel x:Name="SheetActions">
              <TextBlock Text="ACTION" Style="{StaticResource Label}" Margin="4,0,0,6"/>
              <UniformGrid x:Name="ActionsProg" Columns="4" Margin="-3,0">
                <RadioButton Style="{StaticResource Seg}" Tag="shutdown" IsChecked="True">
                  <StackPanel><TextBlock Text="&#xE7E8;" Style="{StaticResource SegIcon}"/><TextBlock Text="Arrêt" Style="{StaticResource SegText}"/></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Seg}" Tag="restart">
                  <StackPanel><TextBlock Text="&#xE72C;" Style="{StaticResource SegIcon}"/><TextBlock Text="Redémarrer" Style="{StaticResource SegText}"/></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Seg}" Tag="sleep">
                  <StackPanel><TextBlock Text="&#xE708;" Style="{StaticResource SegIcon}"/><TextBlock Text="Veille" Style="{StaticResource SegText}"/></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Seg}" Tag="hibernate">
                  <StackPanel><TextBlock Text="&#xE823;" Style="{StaticResource SegIcon}"/><TextBlock Text="Hibernation" Style="{StaticResource SegText}"/></StackPanel>
                </RadioButton>
              </UniformGrid>
            </StackPanel>
            <Border x:Name="WakeNote" Style="{StaticResource Card}" Padding="14,12" VerticalAlignment="Center" Visibility="Hidden">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="#FFFBBF24" Margin="0,2,12,0"/>
                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="#FFC9D1E0"
                           Text="Réveille le PC depuis la veille ou l'hibernation, pas après « Arrêter » du menu Démarrer : éteignez avec le bouton du PC ou « Éteindre le PC », qui hibernent tant qu'un allumage est prévu. Le PC reste ensuite allumé jusqu'à votre retour (2 h max)."/>
              </Grid>
            </Border>
          </Grid>
          <TextBlock x:Name="SheetWarn" TextWrapping="Wrap" FontSize="12" Foreground="#FFFBBF24" Margin="4,10,4,0" Visibility="Collapsed"/>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10" Background="#0F%A1%">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" Foreground="#FF%A1%" VerticalAlignment="Center" Margin="0,1,10,0"/>
              <TextBlock x:Name="SheetNext" Grid.Column="1" FontSize="12.5" Foreground="#FFC9D1E0" TextWrapping="Wrap"/>
            </Grid>
          </Border>
          <UniformGrid Columns="2" Margin="-4,16,-4,0">
            <Button x:Name="SheetCancel" Style="{StaticResource Btn}" Height="48" Margin="4,0" Content="Annuler" IsCancel="True"/>
            <Button x:Name="SheetSave" Style="{StaticResource Cta}" Height="48" Margin="4,0" Content="Enregistrer"/>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Notification éphémère -->
    <Border x:Name="Snack" Grid.RowSpan="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,92" Padding="16,10"
            CornerRadius="12" Background="#F21C2130" BorderBrush="#26FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <Border.Effect><DropShadowEffect ShadowDepth="6" BlurRadius="24" Opacity="0.5" Color="Black"/></Border.Effect>
      <TextBlock x:Name="SnackText" FontSize="13" TextWrapping="Wrap" MaxWidth="340" AutomationProperties.LiveSetting="Polite"/>
    </Border>
  </Grid>
</Window>
