<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installer Sablier" Width="400" Height="600" MinWidth="400" MaxWidth="400" MinHeight="600" MaxHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF0A0C12" Foreground="#FFF3F5F9" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid ClipToBounds="True">
    <Canvas IsHitTestVisible="False">
      <Ellipse CacheMode="BitmapCache" Width="440" Height="440" Canvas.Left="-170" Canvas.Top="-190">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#50%A1%" Offset="0"/>
            <GradientStop Color="#00%A1%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
        <Ellipse.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard Timeline.DesiredFrameRate="20">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="160" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever">
                  <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="110" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever">
                  <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Ellipse.Triggers>
      </Ellipse>
      <Ellipse CacheMode="BitmapCache" Width="400" Height="400" Canvas.Left="170" Canvas.Top="300">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#40%A2%" Offset="0"/>
            <GradientStop Color="#00%A2%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
        <Ellipse.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard Timeline.DesiredFrameRate="20">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-160" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever">
                  <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Ellipse.Triggers>
      </Ellipse>
    </Canvas>

    <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#xE8BB;" ToolTip="Fermer" AutomationProperties.Name="Fermer"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" WindowChrome.IsHitTestVisibleInChrome="True"/>

    <StackPanel Margin="32,44,32,0">
      <Border Width="84" Height="84" CornerRadius="26" Background="{StaticResource Grad}" HorizontalAlignment="Center">
        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.6" Color="#FF%A1%"/></Border.Effect>
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard><Storyboard Timeline.DesiredFrameRate="30">
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-7" Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="40" Foreground="#FF0A0E17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Sablier" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
      <TextBlock Text="Minuterie d'arrêt et allumage programmé" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
      <Border HorizontalAlignment="Center" Margin="0,12,0,0" Padding="8,3" CornerRadius="7" Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1">
        <TextBlock x:Name="Machine" FontSize="10.5" FontWeight="Bold" Foreground="#FF%A1%"/>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="16,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FF%A1%" VerticalAlignment="Center" Width="28"/>
            <TextBlock Text="Éteindre dans 30 min, 1 h, 2 h…" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="&#xE787;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FF%A1%" VerticalAlignment="Center" Width="28"/>
            <TextBlock Text="Éteindre ou allumer le PC chaque semaine" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FF%A1%" VerticalAlignment="Center" Width="28"/>
            <TextBlock Text="Toujours 60 s pour annuler avant l'arrêt" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid Margin="4,18,0,0">
        <TextBlock Text="Raccourci sur le Bureau" FontSize="13.5" VerticalAlignment="Center"/>
        <ToggleButton x:Name="Bureau" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/>
      </Grid>

      <Button x:Name="BtnInstaller" Style="{StaticResource Cta}" Height="54" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="GoIcon" Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,1,10,0"/>
          <TextBlock x:Name="GoText" Text="Installer" FontSize="15"/>
        </StackPanel>
      </Button>
      <TextBlock x:Name="Statut" Text="Pour cette session Windows · sans droits administrateur" FontSize="11.5" Foreground="{StaticResource Sub}"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
  </Grid>
</Window>
