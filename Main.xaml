<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sablier" Width="420" Height="760" MinWidth="420" MaxWidth="420" MinHeight="760" MaxHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF0A0C12" Foreground="#FFF3F5F9" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Ambiance : halos qui dérivent + anneau qui respire. Lancée par le code, en pause quand la fenêtre n'est pas au premier plan. -->
    <Storyboard x:Key="Ambiance" Timeline.DesiredFrameRate="20">
      <DoubleAnimation Storyboard.TargetName="Halo1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="160" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Halo1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="120" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Halo2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-170" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Halo2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="140" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Halo3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="220" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <!-- Anneau qui pulse lentement, seulement quand quelque chose est prévu -->
    <Storyboard x:Key="Pouls" Timeline.DesiredFrameRate="20">
      <DoubleAnimation Storyboard.TargetName="Arc" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>

  <Grid ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Aurore : halos d'accent qui dérivent lentement -->
    <Canvas Grid.RowSpan="4" IsHitTestVisible="False">
      <Ellipse x:Name="Halo1" CacheMode="BitmapCache" Width="480" Height="480" Canvas.Left="-220" Canvas.Top="-200">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#45%A1%" Offset="0"/>
            <GradientStop Color="#00%A1%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="Halo2" CacheMode="BitmapCache" Width="440" Height="440" Canvas.Left="200" Canvas.Top="180">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#38%A2%" Offset="0"/>
            <GradientStop Color="#00%A2%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="Halo3" CacheMode="BitmapCache" Width="360" Height="360" Canvas.Left="-120" Canvas.Top="520">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#26%A1%" Offset="0"/>
            <GradientStop Color="#00%A1%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>

    <!-- Barre de titre -->
    <Grid Margin="20,0,10,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource Grad}">
          <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#FF0A0E17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Sablier" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="BtnMin" Style="{StaticResource Chrome}" Content="&#xE921;" ToolTip="Réduire" AutomationProperties.Name="Réduire"/>
        <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#xE8BB;" ToolTip="Fermer" AutomationProperties.Name="Fermer"/>
      </StackPanel>
    </Grid>

    <!-- Anneau : prochain évènement -->
    <StackPanel Grid.Row="1">
      <Grid Width="232" Height="232">
        <Ellipse Margin="34" Fill="#07FFFFFF"/>
        <!-- Cercle plein : estompé sans programme, pulse (storyboard Pouls) quand quelque chose est prévu -->
        <Ellipse CacheMode="BitmapCache" x:Name="Arc" Margin="16" StrokeThickness="10" Stroke="{StaticResource Grad}" Opacity="0.3">
          <Ellipse.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="24" Color="#FF%A1%" Opacity="0.7"/></Ellipse.Effect>
        </Ellipse>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="HeroBig" Text="--:--" FontSize="42" FontWeight="Light" HorizontalAlignment="Center"/>
          <TextBlock x:Name="HeroSub" FontSize="13" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="HeroInfo" HorizontalAlignment="Center" FontSize="13" Foreground="#FFC9D1E0"/>
      <StackPanel x:Name="HeroActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Hidden">
        <Button x:Name="BtnCancelTimer" Style="{StaticResource Btn}" Height="34" Padding="16,0" Margin="4,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="Annuler"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnPlus15" Style="{StaticResource Btn}" Height="34" Padding="16,0" Margin="4,0" Content="+15 min"/>
        <Button x:Name="BtnEteindre" Style="{StaticResource Btn}" Height="34" Padding="16,0" Margin="4,0" ToolTip="Veille prolongée : l'allumage prévu aura lieu">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="Éteindre"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- Onglets : Extinction | Allumage | Programmes -->
    <Grid Grid.Row="2" Margin="24,12,24,0" Height="44">
      <Border CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"/>
      <Border x:Name="TabPill" Width="121.33" HorizontalAlignment="Left" Margin="4" CornerRadius="10" Background="#1CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      </Border>
      <UniformGrid Columns="3" Margin="4">
        <RadioButton x:Name="TabExt" Style="{StaticResource Tab}" IsChecked="True">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,1,6,0"/>
            <TextBlock Text="Extinction"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabOn" Style="{StaticResource Tab}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,1,6,0"/>
            <TextBlock Text="Allumage"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabProg" Style="{StaticResource Tab}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE787;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,1,6,0"/>
            <TextBlock Text="Programmes"/>
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </Grid>

    <Grid Grid.Row="3" Margin="24,16,24,22">
      <!-- Extinction : minuterie « Dans », ou extinction à heure fixe -->
      <StackPanel x:Name="PanelExt">
        <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        <Border x:Name="DureeCard" Style="{StaticResource Card}" Padding="14,12,14,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <RadioButton x:Name="ModeDans" Style="{StaticResource ModeLabel}" Content="DANS" IsChecked="True"/>
              <RadioButton x:Name="ModeFixe" Style="{StaticResource ModeLabel}" Content="À HEURE FIXE" Margin="16,0,0,0"/>
            </StackPanel>
            <Grid Margin="0,2,0,0">
              <StackPanel x:Name="DansPanel">
                <Grid>
                  <Button x:Name="BtnMoins" Style="{StaticResource Btn}" Width="44" Height="44" HorizontalAlignment="Left" FontFamily="{StaticResource Icons}" FontSize="14" Content="&#xE738;" AutomationProperties.Name="Diminuer la durée"/>
                  <TextBlock x:Name="Duree" Text="1 h" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
                  </TextBlock>
                  <Button x:Name="BtnPlus" Style="{StaticResource Btn}" Width="44" Height="44" HorizontalAlignment="Right" FontFamily="{StaticResource Icons}" FontSize="14" Content="&#xE710;" AutomationProperties.Name="Augmenter la durée"/>
                </Grid>
                <UniformGrid x:Name="Presets" Columns="5" Margin="-3,10,-3,0">
                  <Button Style="{StaticResource Mini}" Tag="15" Content="15 min"/>
                  <Button Style="{StaticResource Mini}" Tag="30" Content="30 min"/>
                  <Button Style="{StaticResource Mini}" Tag="60" Content="1 h"/>
                  <Button Style="{StaticResource Mini}" Tag="120" Content="2 h"/>
                  <Button Style="{StaticResource Mini}" Tag="180" Content="3 h"/>
                </UniformGrid>
              </StackPanel>
              <StackPanel x:Name="FixePanel" Visibility="Hidden">
                <Grid>
                  <RepeatButton x:Name="ExtMoins" Style="{StaticResource Btn}" Width="40" Height="40" HorizontalAlignment="Left" FontFamily="{StaticResource Icons}" FontSize="14" Content="&#xE738;" AutomationProperties.Name="Reculer de 15 min"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="EHH" Style="{StaticResource TimeBox}" Width="76" Height="48" FontSize="30" AutomationProperties.Name="Heures"/>
                    <TextBlock Text=":" FontSize="26" FontWeight="Light" VerticalAlignment="Center" Margin="6,0,6,4" Foreground="{StaticResource Sub}"/>
                    <TextBox x:Name="EMM" Style="{StaticResource TimeBox}" Width="76" Height="48" FontSize="30" AutomationProperties.Name="Minutes"/>
                  </StackPanel>
                  <RepeatButton x:Name="ExtPlus" Style="{StaticResource Btn}" Width="40" Height="40" HorizontalAlignment="Right" FontFamily="{StaticResource Icons}" FontSize="14" Content="&#xE710;" AutomationProperties.Name="Avancer de 15 min"/>
                </Grid>
                <UniformGrid x:Name="JoursExt" Columns="7" Margin="-3,10,-3,0">
                  <UniformGrid.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></UniformGrid.LayoutTransform>
                  <ToggleButton Style="{StaticResource Day}" Content="L"/>
                  <ToggleButton Style="{StaticResource Day}" Content="M"/>
                  <ToggleButton Style="{StaticResource Day}" Content="M"/>
                  <ToggleButton Style="{StaticResource Day}" Content="J"/>
                  <ToggleButton Style="{StaticResource Day}" Content="V"/>
                  <ToggleButton Style="{StaticResource Day}" Content="S"/>
                  <ToggleButton Style="{StaticResource Day}" Content="D"/>
                </UniformGrid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="ACTION" Style="{StaticResource Label}" Margin="4,16,0,6"/>
        <UniformGrid x:Name="ActionsTimer" Columns="4" Margin="-3,0">
          <RadioButton Style="{StaticResource Seg}" Tag="shutdown" IsChecked="True">
            <StackPanel><TextBlock Text="&#xE7E8;" Style="{StaticResource SegIcon}"/><TextBlock Text="Arrêt" Style="{StaticResource SegText}"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" Tag="restart">
            <StackPanel><TextBlock Text="&#xE72C;" Style="{StaticResource SegIcon}"/><TextBlock Text="Redémarrer" Style="{StaticResource SegText}"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" Tag="sleep">
            <StackPanel><TextBlock Text="&#xE708;" Style="{StaticResource SegIcon}"/><TextBlock Text="Veille" Style="{StaticResource SegText}"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" Tag="hibernate">
            <StackPanel><TextBlock Text="&#xE823;" Style="{StaticResource SegIcon}"/><TextBlock Text="Hibernation" Style="{StaticResource SegText}"/></StackPanel>
          </RadioButton>
        </UniformGrid>
        <Button x:Name="BtnGo" Style="{StaticResource Cta}" Height="56" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock x:Name="GoTitre" Text="Lancer la minuterie" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="GoSub" FontSize="11.5" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Allumage : formulaire direct -->
      <StackPanel x:Name="PanelOn" Visibility="Collapsed">
        <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        <Border Style="{StaticResource Card}" Padding="14,12">
          <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <RadioButton x:Name="ModeUne" Style="{StaticResource ModeLabel}" Content="UNE FOIS" IsChecked="True"/>
              <RadioButton x:Name="ModeChaque" Style="{StaticResource ModeLabel}" Content="CHAQUE SEMAINE" Margin="16,0,0,0"/>
            </StackPanel>
            <Grid Margin="0,10,0,0">
              <RepeatButton x:Name="OnMoins" Style="{StaticResource Btn}" Width="40" Height="40" HorizontalAlignment="Left" FontFamily="{StaticResource Icons}" FontSize="14" Content="&#xE738;" AutomationProperties.Name="Reculer de 15 min"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox x:Name="HH" Style="{StaticResource TimeBox}" Width="80" Height="48" FontSize="30" AutomationProperties.Name="Heures"/>
                <TextBlock Text=":" FontSize="26" FontWeight="Light" VerticalAlignment="Center" Margin="6,0,6,4" Foreground="{StaticResource Sub}"/>
                <TextBox x:Name="MM" Style="{StaticResource TimeBox}" Width="80" Height="48" FontSize="30" AutomationProperties.Name="Minutes"/>
              </StackPanel>
              <RepeatButton x:Name="OnPlus" Style="{StaticResource Btn}" Width="40" Height="40" HorizontalAlignment="Right" FontFamily="{StaticResource Icons}" FontSize="14" Content="&#xE710;" AutomationProperties.Name="Avancer de 15 min"/>
            </Grid>
            <Grid Margin="0,10,0,0" Height="40">
              <Grid x:Name="DateRow">
                <Button x:Name="DPrev" Style="{StaticResource Btn}" Width="44" Height="40" HorizontalAlignment="Left" FontFamily="{StaticResource Icons}" FontSize="12" Content="&#xE76B;" AutomationProperties.Name="Jour précédent"/>
                <TextBlock x:Name="DateText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="DNext" Style="{StaticResource Btn}" Width="44" Height="40" HorizontalAlignment="Right" FontFamily="{StaticResource Icons}" FontSize="12" Content="&#xE76C;" AutomationProperties.Name="Jour suivant"/>
              </Grid>
              <Grid x:Name="JoursOnRow" Visibility="Hidden">
                <UniformGrid x:Name="JoursOn" Columns="7" VerticalAlignment="Center">
                  <UniformGrid.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></UniformGrid.LayoutTransform>
                  <ToggleButton Style="{StaticResource Day}" Content="L"/>
                  <ToggleButton Style="{StaticResource Day}" Content="M"/>
                  <ToggleButton Style="{StaticResource Day}" Content="M"/>
                  <ToggleButton Style="{StaticResource Day}" Content="J"/>
                  <ToggleButton Style="{StaticResource Day}" Content="V"/>
                  <ToggleButton Style="{StaticResource Day}" Content="S"/>
                  <ToggleButton Style="{StaticResource Day}" Content="D"/>
                </UniformGrid>
              </Grid>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="Le PC doit être en veille prolongée pour se rallumer : éteignez-le avec « Éteindre » de Sablier ou le bouton du PC, pas avec Démarrer › Arrêter." TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{StaticResource Sub}" Margin="6,14,6,0"/>
        <Button x:Name="BtnAllumage" Style="{StaticResource Cta}" Height="56" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Programmer l'allumage" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="OnSub" FontSize="11.5" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Programmes : la liste -->
      <Grid x:Name="PanelProg" Visibility="Collapsed">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
          <ItemsControl x:Name="Liste">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
                  <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                  <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.4">
                          <DoubleAnimation.EasingFunction><CubicEase/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard></BeginStoryboard>
                    </EventTrigger>
                  </Border.Triggers>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="13" Background="{Binding Fond}">
                      <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="#FF0A0E17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Heure}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Titre}" FontSize="12.5" Foreground="#FFC9D1E0" Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Sous}" FontSize="12" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="En veille prolongée : allumage prévu" FontSize="11.5" Foreground="#FFFBBF24" Margin="0,2,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Hiberne}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Actif, Mode=OneWay}" Tag="{Binding}" VerticalAlignment="Center"
                                  ToolTip="Activer / mettre en pause" AutomationProperties.Name="Activer le programme"/>
                    <Button Grid.Column="3" Style="{StaticResource Btn}" Width="34" Height="34" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                            FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" Content="&#xE74D;" Tag="{Binding}"
                            ToolTip="Supprimer" AutomationProperties.Name="Supprimer le programme"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="Vide" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="&#xE787;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
          <TextBlock Text="Rien de prévu" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
          <TextBlock Text="Programmez une extinction ou un allumage depuis les onglets Extinction et Allumage." TextWrapping="Wrap" TextAlignment="Center" Width="260" Foreground="{StaticResource Sub}"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Guide après un allumage enregistré : comment éteindre pour qu'il ait lieu -->
    <Grid x:Name="Sheet" Grid.RowSpan="4" Visibility="Collapsed">
      <Border x:Name="SheetDim" Background="#B305070C" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Border x:Name="GuideCard" VerticalAlignment="Bottom" CornerRadius="26,26,0,0" Background="#FF121621" BorderBrush="#1FFFFFFF" BorderThickness="1,1,1,0" Padding="24,12,24,22" Visibility="Collapsed">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        <StackPanel>
          <Border Width="42" Height="4" CornerRadius="2" Background="#33FFFFFF" HorizontalAlignment="Center"/>
          <Border Width="48" Height="48" CornerRadius="15" Background="{StaticResource Sun}" HorizontalAlignment="Left" Margin="0,16,0,0">
            <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#FF0A0E17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="GuideTitre" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"/>
          <TextBlock x:Name="GuideTexte" FontSize="13" Foreground="#FFC9D1E0" TextWrapping="Wrap" LineHeight="20"/>
          <UniformGrid Columns="2" Margin="-4,20,-4,0">
            <Button x:Name="GuideTard" Style="{StaticResource Btn}" Height="48" Margin="4,0" Content="Plus tard"/>
            <Button x:Name="GuideOff" Style="{StaticResource Cta}" Height="48" Margin="4,0" Content="Éteindre maintenant"/>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Notification éphémère -->
    <Border x:Name="Snack" Grid.RowSpan="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,92" Padding="16,10"
            CornerRadius="12" Background="#F21C2130" BorderBrush="#26FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <TextBlock x:Name="SnackText" FontSize="13" TextWrapping="Wrap" MaxWidth="340" AutomationProperties.LiveSetting="Polite"/>
    </Border>
  </Grid>
</Window>
