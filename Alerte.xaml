<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sablier" Width="380" Height="470" MinWidth="380" MaxWidth="380" MinHeight="470" MaxHeight="470"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Topmost="True"
        Background="#FF0A0C12" Foreground="#FFF3F5F9" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid ClipToBounds="True">
    <Canvas IsHitTestVisible="False">
      <Ellipse CacheMode="BitmapCache" Width="420" Height="420" Canvas.Left="-160" Canvas.Top="-160">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#50%A1%" Offset="0"/>
            <GradientStop Color="#00%A1%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
        <Ellipse.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard Timeline.DesiredFrameRate="20">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="140" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever">
                  <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="120" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever">
                  <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Ellipse.Triggers>
      </Ellipse>
      <Ellipse CacheMode="BitmapCache" Width="380" Height="380" Canvas.Left="160" Canvas.Top="200">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#40%A2%" Offset="0"/>
            <GradientStop Color="#00%A2%" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
        <Ellipse.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard Timeline.DesiredFrameRate="20">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-150" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever">
                  <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Ellipse.Triggers>
      </Ellipse>
    </Canvas>

    <StackPanel VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
      <StackPanel.RenderTransform><ScaleTransform/></StackPanel.RenderTransform>
      <StackPanel.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.5">
              <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.5">
              <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard></BeginStoryboard>
        </EventTrigger>
      </StackPanel.Triggers>

      <TextBlock x:Name="Titre" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="Info" Text="Pensez à enregistrer votre travail" Foreground="{StaticResource Sub}" HorizontalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center" Margin="24,4,24,0"/>
      <Grid Width="200" Height="200" Margin="0,22">
        <Ellipse Margin="12" Stroke="#14FFFFFF" StrokeThickness="10"/>
        <Path CacheMode="BitmapCache" x:Name="Arc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
          <Path.Stroke>
            <LinearGradientBrush MappingMode="Absolute" StartPoint="12,12" EndPoint="188,188">
              <GradientStop Color="#FF%A1%" Offset="0"/>
              <GradientStop Color="#FF%A2%" Offset="1"/>
            </LinearGradientBrush>
          </Path.Stroke>
          <Path.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="26" Color="#FF%A1%" Opacity="0.8"/></Path.Effect>
          <Path.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard><Storyboard Timeline.DesiredFrameRate="20">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
              </Storyboard></BeginStoryboard>
            </EventTrigger>
          </Path.Triggers>
        </Path>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="Sec" Text="60" FontSize="60" FontWeight="Light" HorizontalAlignment="Center"/>
          <TextBlock Text="secondes" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
        </StackPanel>
      </Grid>
      <UniformGrid Columns="3" Margin="24,0">
        <Button x:Name="BtnAnnuler" Style="{StaticResource Btn}" Height="46" Margin="4,0" Content="Annuler" IsCancel="True"/>
        <Button x:Name="BtnReporter" Style="{StaticResource Btn}" Height="46" Margin="4,0" Content="+15 min"/>
        <Button x:Name="BtnMaintenant" Style="{StaticResource Cta}" Height="46" Margin="4,0" Content="Maintenant"/>
      </UniformGrid>
    </StackPanel>
  </Grid>
</Window>
